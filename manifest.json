{
  "manifest_version": 3,
  "name": "Input Translator",
  "version": "1.1.1",
  "minimum_chrome_version": "119",
  "description": "Translate text in editable fields on the first Enter, then submit normally on the second Enter.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Input Translator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
